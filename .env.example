# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (matches docker-compose.yml)
POSTGRES_USER=parsimony
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=parsimony
DATABASE_URL=postgresql+psycopg://parsimony:change-me-locally@db:5432/parsimony

# Session cookie signing (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# Gemini (use a key from a dedicated Parsimony Google Cloud project)
GEMINI_API_KEY=
# Merchant logos: leave false until a paid Gemini key is set (see docs/decisions.md).
LOGOS_ENABLED=false
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Optional: a different model for receipt photos. Empty = use the text model.
GEMINI_VISION_MODEL=

# Daily AI-call caps (reset 00:00 UTC)
AI_DAILY_CAP_USER=30
AI_DAILY_CAP_DEMO=10
AI_DAILY_CAP_GLOBAL=300
# Typing is free, with a hidden fair-use cap (does not use up smart adds)
TEXT_DAILY_CAP_USER=300
TEXT_DAILY_CAP_DEMO=50
TEXT_DAILY_CAP_GLOBAL=1000

# Demo accounts and abuse limits
DEMO_TTL_DAYS=7
DEMO_MAX_ACTIVE=200
MAX_ENTRIES_USER=1000
MAX_ENTRIES_DEMO=100

