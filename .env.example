# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (matches docker-compose.yml)
POSTGRES_USER=parsimony
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=parsimony
DATABASE_URL=postgresql+psycopg://parsimony:change-me-locally@db:5432/parsimony

# Session cookie signing (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# Gemini (use a key from a dedicated Parsimony Google Cloud project)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
