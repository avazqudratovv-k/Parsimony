# Copy to .env ON THE SERVER only. Never commit the real file.
APP_ENV=production
POSTGRES_USER=parsimony
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=parsimony
# The password here must match POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://parsimony:GENERATE_A_LONG_RANDOM_PASSWORD@db:5432/parsimony
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GENERATE_A_RANDOM_VALUE
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
AI_DAILY_CAP_USER=30
AI_DAILY_CAP_DEMO=10
AI_DAILY_CAP_GLOBAL=300
DEMO_TTL_DAYS=7
DEMO_MAX_ACTIVE=200
MAX_ENTRIES_USER=1000
MAX_ENTRIES_DEMO=100
